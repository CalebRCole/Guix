;; Configuration

(defcfg
  process-unmapped-keys yes
  allow-hardware-repeat false
)

(defsrc
  `                                                                    -     =      bspc
           q     w     e     r     t     y     u     i     o     p     [     ]
  caps     a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft     z     x     c     v     b     n     m     ,     .     /     rsft
  lctl     lmet  lalt              spc                     ralt        rctl
)


;; Variables

(defvar
  tap-time         0
  hold-time        150
  chord-timeout    50
)


;; Aliases

(defalias
  num (layer-while-held numbers-and-symbols)
  
  back (fork C-bspc bspc (lsft)) ;; Makes backspace delete words by default, and control-backspace delete characters.

  sp_l (tap-hold $tap-time $hold-time spc (layer-while-held space-layer))

  gob (tap-hold $tap-time $hold-time ` (layer-switch base))
)


;; Templates

(deftemplate th (name key modifier)
  $name (tap-hold $tap-time $hold-time $key $modifier)
)


;; Template Aliases
;; 't' at beginning of alias refers to a tap-hold action!

(defalias
  (t! th tcec esc lctl)  ;; Caps into tap escape, hold control
  (t! th tscl lpar lsft) ;; Space Cadet left-shift
  (t! th tscr rpar rsft) ;; Space Cadet right-shift

  ;; Home-row modifiers
  ;; Outside -> Inside
  ;; Super/Meta, Alt, Control, Shift
  (t! th tsa s lalt)
  (t! th tdc d lctl)
  (t! th tfs f lsft)
  
  (t! th tjs j rsft)
  (t! th tkc k rctl)
  (t! th tla l lalt)
)


;; Chords




;; Layers

(deflayer base
  `                                                                    -     =     @back
           q     w     e     r     t     y     u     i     o     p     [     ]
  @tcec    a     @tsa  @tdc  @tfs  g     h     @tjs  @tkc  @tla  ;     '     ret
  @tscl    z     x     c     v     b     n     m     ,     .     /     @tscr
  lctl     lmet  @num              @sp_l                   ralt        rctl
)


(deflayer numbers-and-symbols
  `                                                                    -     =     _
           1     2     3     4     5     6     7     8     9     0     [     ]
  _        S-1   S-2   S-3   S-4   S-5   S-6   S-7   S-8   S-eql min   eql   _
  _        S-`   \     S-[   S-,   S-\   S-.   S-]   S-;   S-'   /     _
  lmet     _     _                 _                       _           _
)

(deflayer standard
  @gob                                                                 -     =     bspc
           q     w     e     r     t     y     u     i     o     p     [     ]
  @tcec    a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft     z     x     c     v     b     n     m     ,     .     /     rsft
  lctl     lmet  lalt              spc                     ralt        rctl
)

(deflayermap (space-layer)
  n bspc
  b C-bspc
  m del
  , C-del
  o ret
  h left
  j down
  k up
  l right
  a home
  e end
  d pgdn
  u pgup
  caps (tap-dance $hold-time (esc lctl S-ctl)) ;; 1 = Esc, 2 = Ctrl, 3 = Shift-Ctrl
  ` lrld
  = (layer-switch gaming)
)
